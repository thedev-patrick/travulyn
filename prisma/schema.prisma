generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
  SUPERADMIN
}

enum ApplicationStatus {
  ONBOARDED
  DOCS_PENDING
  IN_REVIEW
  APPROVED
  COMPLETED
}

enum DocumentStatus {
  PENDING
  UPLOADED
  APPROVED
  REJECTED
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  blogPosts       BlogPost[]
  onboardedCustomers Customer[]      @relation("OnboardedBy")
  createdApplications Application[] @relation("ApplicationCreatedBy")
  progressEvents  ProgressEvent[]

  @@map("admin_users")
}

model Country {
  id        String   @id @default(cuid())
  name      String   @unique
  isoCode   String   @unique
  flagEmoji String?
  createdAt DateTime @default(now())

  corridorsAsOrigin      Corridor[] @relation("OriginCountry")
  corridorsAsDestination Corridor[] @relation("DestinationCountry")
  applicationsAsOrigin      Application[] @relation("ApplicationOriginCountry")
  applicationsAsDestination Application[] @relation("ApplicationDestinationCountry")

  @@map("countries")
}

model Corridor {
  id               String   @id @default(cuid())
  originCountryId      String
  destinationCountryId String
  priceEstimateMin Decimal  @db.Decimal(10, 2)
  priceEstimateMax Decimal  @db.Decimal(10, 2)
  currency         String   @default("USD")
  processingDays   Int
  summary          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  originCountry      Country @relation("OriginCountry", fields: [originCountryId], references: [id], onDelete: Cascade)
  destinationCountry Country @relation("DestinationCountry", fields: [destinationCountryId], references: [id], onDelete: Cascade)
  documents          CorridorDocument[]
  applications       Application[]

  @@unique([originCountryId, destinationCountryId])
  @@map("corridors")
}

model RequiredDocument {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  corridors         CorridorDocument[]
  applicationDocuments ApplicationDocument[]

  @@map("required_documents")
}

model CorridorDocument {
  id                 String  @id @default(cuid())
  corridorId         String
  requiredDocumentId String
  isMandatory        Boolean @default(true)
  notes              String?

  corridor         Corridor         @relation(fields: [corridorId], references: [id], onDelete: Cascade)
  requiredDocument RequiredDocument @relation(fields: [requiredDocumentId], references: [id], onDelete: Cascade)

  @@unique([corridorId, requiredDocumentId])
  @@map("corridor_documents")
}

model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String
  contentMarkdown String
  coverImageUrl   String?
  published       Boolean   @default(false)
  publishedAt     DateTime?
  authorId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  author AdminUser @relation(fields: [authorId], references: [id])

  @@map("blog_posts")
}

model Testimonial {
  id              String   @id @default(cuid())
  customerName    String
  customerPhotoUrl String?
  countryContext  String?
  quote           String
  rating          Int      @default(5)
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@map("testimonials")
}

model Customer {
  id                    String         @id @default(cuid())
  fullName              String
  email                 String         @unique
  phone                 String?
  createdByAdminId      String
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  createdByAdmin AdminUser     @relation("OnboardedBy", fields: [createdByAdminId], references: [id])
  applications   Application[]

  @@map("customers")
}

model Application {
  id                    String            @id @default(cuid())
  customerId            String
  originCountryId       String
  destinationCountryId  String
  corridorId            String
  status                ApplicationStatus @default(ONBOARDED)
  accessToken           String            @unique
  tokenExpiresAt        DateTime
  createdByAdminId      String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  originCountry        Country   @relation("ApplicationOriginCountry", fields: [originCountryId], references: [id])
  destinationCountry   Country   @relation("ApplicationDestinationCountry", fields: [destinationCountryId], references: [id])
  corridor             Corridor  @relation(fields: [corridorId], references: [id])
  createdByAdmin       AdminUser @relation("ApplicationCreatedBy", fields: [createdByAdminId], references: [id])
  documents            ApplicationDocument[]
  progressEvents       ProgressEvent[]

  @@index([accessToken])
  @@map("applications")
}

model ApplicationDocument {
  id                 String         @id @default(cuid())
  applicationId      String
  requiredDocumentId String
  status             DocumentStatus @default(PENDING)
  fileUrl            String?
  rejectionReason    String?
  uploadedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  application      Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requiredDocument RequiredDocument @relation(fields: [requiredDocumentId], references: [id])

  @@unique([applicationId, requiredDocumentId])
  @@map("application_documents")
}

model ProgressEvent {
  id              String   @id @default(cuid())
  applicationId   String
  title           String
  description     String?
  createdByAdminId String
  createdAt       DateTime @default(now())

  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdByAdmin  AdminUser   @relation(fields: [createdByAdminId], references: [id])

  @@map("progress_events")
}

model Inquiry {
  id                    String   @id @default(cuid())
  name                  String
  email                 String
  message               String
  originCountryId       String?
  destinationCountryId  String?
  handled               Boolean  @default(false)
  createdAt             DateTime @default(now())

  @@map("inquiries")
}
