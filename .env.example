# Postgres connection string used by the app at runtime (local Prisma Postgres in dev via
# `npx prisma dev`; the *pooled* connection string in production, e.g. Neon's default one)
DATABASE_URL=""

# Unpooled/"direct" connection string, used only by `prisma migrate`/`db push`. Required for
# providers whose pooled connection uses PgBouncer transaction pooling (e.g. Neon) — their
# pooled connection can't take the advisory locks Prisma's migration engine needs. Leave unset
# for local dev (`prisma dev`'s connection isn't pooled) or providers without this restriction.
DIRECT_URL=""

# Auth.js (NextAuth) - admin login
AUTH_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudinary - document/image uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SendGrid - transactional email (magic links, progress updates)
SENDGRID_API_KEY=""
EMAIL_FROM="no-reply@travulyn.com"

# Seed admin account (used by prisma/seed.ts, first deploy only)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
